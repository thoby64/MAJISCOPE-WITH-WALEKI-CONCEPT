# ============================================================
# Majiscope Backend - Environment Configuration
# Copy this file to .env and fill in your configuration
# ============================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
# Local SQLite databases. Use separate PostgreSQL URLs for hosted environments.
DATABASE_URL=sqlite:///./majiscope.db
SENSOR_DATABASE_URL=sqlite:///./sensor_platform.db

# Report media storage (local for development; configure private S3 bucket in production)
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=.media_objects
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_ADDRESSING_STYLE=auto
# Optional encryption: AES256 or aws:kms; set KMS key ID when using aws:kms
MEDIA_S3_SSE=
MEDIA_S3_KMS_KEY_ID=
# Opt-in for a local, single-instance boot to migrate legacy report media.
# Hosted multi-instance deployments should run the controlled backfill job instead.
MEDIA_BACKFILL_ON_STARTUP=false

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration (IMPORTANT for CORS)
# This URL is used to allow requests from the frontend and generate frontend links
FRONTEND_URL=http://localhost:3000

# API Configuration
API_PREFIX=/api

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional one-time historical DUWASA import on startup
LEGACY_DUWASA_IMPORT_ON_STARTUP=false
# Optional override. Leave blank to use the CSV committed inside the backend folder.
LEGACY_DUWASA_IMPORT_CSV_PATH=
LEGACY_DUWASA_IMPORT_STRICT=false
# LEGACY_DUWASA_IMPORT_LIMIT=50
