# ============================================================
# MajiScope Backend — RENDER ENVIRONMENT VARIABLES (example)
# These values go into Render Dashboard → Environment (NOT a .env file).
# ENVIRONMENT=production makes the backend ignore any .env file,
# so on Render ONLY these env vars matter.
# Replace <your-service> placeholders with your actual Render URLs
# after you create each service.
# ============================================================

ENVIRONMENT=production
DEBUG=false

# Keep production web startup free of concurrent schema DDL. Configure the
# Render service Pre-Deploy Command as `bash scripts/render_predeploy.sh`.
# This applies both Alembic histories once before the backend process starts.
RUN_STARTUP_MIGRATIONS=false
RUN_STARTUP_SCHEMA_SYNC=false
RUN_SENSOR_PLATFORM_STARTUP_RECONCILE=true
MEDIA_BACKFILL_ON_STARTUP=false

# ── Databases (Neon) ──────────────────────────────
# Main business database (users, utilities, DMAs, reports...)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_MAIN_PASSWORD@YOUR-NEON-MAIN-HOST-pooler.aws.neon.tech/majiscopedb?sslmode=require
# Sensor platform database (telemetry + sensor registry)
SENSOR_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_SENSOR_PASSWORD@YOUR-NEON-SENSOR-HOST-pooler.aws.neon.tech/sensrplatm?sslmode=require

# ── Private report media object storage ───────────────────────────────
MEDIA_STORAGE_BACKEND=s3
MEDIA_S3_BUCKET=majiscope-report-media
MEDIA_S3_REGION=garage
MEDIA_S3_ENDPOINT_URL=https://<your-cs3-object-storage>.onrender.com
MEDIA_S3_ACCESS_KEY_ID=<same-as-GARAGE_DEFAULT_ACCESS_KEY>
MEDIA_S3_SECRET_ACCESS_KEY=<same-as-GARAGE_DEFAULT_SECRET_KEY>
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_ADDRESSING_STYLE=path
# Garage does not support S3 server-side encryption headers.
MEDIA_S3_SSE=
MEDIA_S3_KMS_KEY_ID=

# ── Security ───────────────────────────────────────
SECRET_KEY=replace-with-your-real-production-secret-at-least-32-chars
SENSOR_INGEST_KEY=sWFDbIuNd_QG45qWQb5TGtm6RH1LQnLcpNVQPoRRlu4

# ── URLs / CORS (fill in after creating services) ─
# Your Render frontend service URL:
FRONTEND_URL=https://<your-frontend>.onrender.com
# This backend's public Render URL:
PUBLIC_BACKEND_URL=https://<your-backend>.onrender.com
# Comma-separated allowed origins:
CORS_ORIGINS=https://<your-frontend>.onrender.com

HOST=0.0.0.0
PORT=8000

INVITE_TOKEN_EXPIRY_HOURS=72
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=2

# Optional one-time historical DUWASA import on deploy
LEGACY_DUWASA_IMPORT_ON_STARTUP=false
LEGACY_DUWASA_IMPORT_CSV_PATH=
LEGACY_DUWASA_IMPORT_STRICT=false
# LEGACY_DUWASA_IMPORT_LIMIT=50

# Keep normal tank startup reconciliation enabled.
RUN_TANK_GPKG_SYNC_ON_STARTUP=true

# ── Email (optional, for invites) ─────────────────
# Recommended: Resend (Render free tier blocks SMTP ports)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Majiscope
