# MajiScope Sensor Simulator — Environment
# Copy to .env for local use. On Render, set these in the dashboard instead.

# Full ingest URL of the MajiScope backend (includes /api/sensors/ingest)
MAJISCOPE_URL=http://localhost:8000/api/sensors/ingest

# Must match the backend's SENSOR_INGEST_KEY
INGEST_KEY=your-secret-key-here

# Seconds between readings
INTERVAL=30
