# MajiScope Sensor Simulator — Environment
# Copy to .env for local use. On Render, set these in the dashboard instead.

# Full ingest URL for storage-facility sensors
MAJISCOPE_STORAGE_FACILITY_URL=http://localhost:8000/api/storage-facility-sensors/ingest

# Full ingest URL for water-source sensors
MAJISCOPE_WATER_SOURCE_URL=http://localhost:8000/api/water-source-sensors/ingest

# Must match the backend's SENSOR_INGEST_KEY
INGEST_KEY=your-secret-key-here

# Seconds between readings
INTERVAL=30
