# Local single-node Garage S3 server. Replace these development credentials
# before exposing the service beyond this computer.
GARAGE_DEFAULT_ACCESS_KEY=local-test-access-key
GARAGE_DEFAULT_SECRET_KEY=local-test-secret-key-change-before-use
GARAGE_DEFAULT_BUCKET=majiscope-local-media
CS3_UI_PORT=3900
CS3_UI_BIND_ADDRESS=127.0.0.1
CS3_S3_PORT=3902
CS3_S3_REGION=garage
