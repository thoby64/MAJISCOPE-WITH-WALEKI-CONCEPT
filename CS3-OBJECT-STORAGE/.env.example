# The storage service uses one HTTP listener for its dashboard and file API.
# Replace both values with distinct, private secrets before exposing the service.
CS3_STORAGE_API_KEY=replace-with-unique-random-secret-at-least-32-characters
CS3_UI_PASSPHRASE=replace-with-a-separate-dashboard-passphrase
CS3_UI_BIND_ADDRESS=127.0.0.1
CS3_UI_PORT=8082
CS3_STORAGE_ROOT=./data
CS3_MAX_OBJECT_SIZE_BYTES=1073741824
